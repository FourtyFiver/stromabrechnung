# -----------------------------------------------------------------------------
# Admin Zugangsdaten
# -----------------------------------------------------------------------------
# Der Benutzername für den Administrator-Login auf dem Portal.
ADMIN_USERNAME=admin

# Das Passwort für den Administrator. WICHTIG: Bitte ändern Sie dies!
# Wenn ADMIN_PASSWORD nicht gesetzt ist, ist der Login über Umgebungsvariablen deaktiviert
# und nur Datenbank-Benutzer können sich anmelden.
# WICHTIG:
# - Keine Anführungszeichen verwenden!
# - Dollar-Zeichen ($) müssen verdoppelt werden ($$)!
# - Verwenden Sie KEINE der folgenden Default-Werte: admin123, password, admin
#   Der Server gibt eine Warnung aus, wenn ein bekanntes unsicheres Passwort erkannt wird.
# Beispiel: für 'pass$word' schreibe: ADMIN_PASSWORD=pass$$word
ADMIN_PASSWORD=secure_password_please_change

# -----------------------------------------------------------------------------
# NextAuth Konfiguration (Authentifizierung)
# -----------------------------------------------------------------------------
# Die vollständige URL, unter der die Anwendung erreichbar ist.
# Lokal: http://localhost:3000
# Produktion: https://deine-domain.de
NEXTAUTH_URL=http://localhost:3000

# Ein zufälliger String zur Verschlüsselung der Session-Tokens.
# Kann generiert werden mit:
# - Linux/Mac (Bash): 'openssl rand -base64 32'
# - Windows (PowerShell): [Convert]::ToBase64String((1..32 | %{ [byte](Get-Random -Max 256) }))
NEXTAUTH_SECRET=super_secret_random_string

# ----------------------------------------------------------------------------- 
# Authentik SSO (Optional)
# -----------------------------------------------------------------------------
# OIDC-Login über Authentik. Sind alle drei Werte gesetzt, erscheint zusätzlich
# der Button "Mit Authentik anmelden" auf der Login-Seite. Ohne die Werte
# verhält sich die App unverändert (nur Credentials-Login).
#
# Authentik: Applications → Providers → Create (OAuth2/OpenID Connect, confidential)
#   - Redirect URI:  <NEXTAUTH_URL>/api/auth/callback/authentik
#   - Client ID + Client Secret aus dem Provider übernehmen
#   - Issuer: https://<authentik-host>/application/o/<provider-slug>  (OHNE trailing slash!)
AUTHENTIK_ID=
AUTHENTIK_SECRET=
AUTHENTIK_ISSUER=

# -----------------------------------------------------------------------------
# Datenbank
# -----------------------------------------------------------------------------
# Pfad zur SQLite Datenbankdatei.
# "file:./dev.db" erstellt die Datei im prisma Ordner.
# Bei Verwendung von Docker wird dieser Pfad im Container gemappt.
DATABASE_URL=file:./dev.db

# -----------------------------------------------------------------------------
# Telegram Integration (Optional)
# -----------------------------------------------------------------------------
# Token vom BotFather
TELEGRAM_BOT_TOKEN=
# Deine Chat ID (findest du heraus, indem du dem Bot schreibst und getUpdates abrufst)
TELEGRAM_CHAT_ID=